# Copy to ".env.supabase" and fill real values. Do not commit real secrets.

SPRING_PROFILES_ACTIVE=supabase

# Supabase Settings > Database > Connection string > Session pooler.
# Recommended for this Spring backend: session pooler with SSL and a limited app role.
# Example:
# DB_URL=jdbc:postgresql://db.<project-ref>.supabase.co:5432/postgres?sslmode=require
DB_URL=jdbc:postgresql://aws-0-eu-west-3.pooler.supabase.com:5432/postgres?sslmode=require
DB_USERNAME=fichestu_app.mzzbrrmgmsjvuycuazjl
DB_PASSWORD=<database-password>

HIBERNATE_DDL_AUTO=validate
HIBERNATE_SHOW_SQL=false
FLYWAY_ENABLED=false

JWT_SECRET=change-this-production-jwt-secret-at-least-32-bytes
JWT_EXPIRATION_SECONDS=3600

PASSWORD_RESET_EXPIRATION_MINUTES=15
PASSWORD_RESET_MAIL_ENABLED=false
PASSWORD_RESET_FROM=fichestu.soporte@gmail.com

EMAIL_NOTIFICATIONS_ENABLED=false
EMAIL_NOTIFICATIONS_FROM=fichestu.soporte@gmail.com

MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SMTP_AUTH=false
MAIL_SMTP_STARTTLS_ENABLE=false
MAIL_SMTP_STARTTLS_REQUIRED=false
MAIL_CONNECTION_TIMEOUT_MS=10000
MAIL_TIMEOUT_MS=10000
MAIL_WRITE_TIMEOUT_MS=10000
