# Copy this file to ".env" and change the values you need.
# Do not commit your real ".env" file.

# Database used by docker-compose.
# If you run the backend with docker-compose, keep DB_URL as "db:3306".
# If you run the backend directly from Eclipse/IntelliJ against Docker MySQL,
# use localhost:3307 instead of db:3306.
DB_URL=jdbc:mysql://db:3306/fichestu_db?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
DB_USERNAME=root
DB_PASSWORD=root
DB_DRIVER=com.mysql.cj.jdbc.Driver
HIBERNATE_DDL_AUTO=validate
HIBERNATE_SHOW_SQL=false

# JWT.
# For local testing this example value works.
# For production, generate a private random secret of at least 32 characters.
# Example PowerShell command:
# [Convert]::ToBase64String((1..48 | ForEach-Object { Get-Random -Maximum 256 }))
JWT_SECRET=change-this-local-jwt-secret-at-least-32-bytes
JWT_EXPIRATION_SECONDS=3600

# Password reset.
# false = do not send real emails. Good default for local testing.
# true = send emails using the SMTP settings below.
PASSWORD_RESET_EXPIRATION_MINUTES=15
PASSWORD_RESET_MAIL_ENABLED=false
PASSWORD_RESET_FROM=fichestu.suporte@gmail.com

# Automated emails for registration, transactions and important updates.
EMAIL_NOTIFICATIONS_ENABLED=false
EMAIL_NOTIFICATIONS_FROM=fichestu.suporte@gmail.com

# SMTP.
# For Gmail:
# MAIL_HOST=smtp.gmail.com
# MAIL_PORT=587
# MAIL_USERNAME=your-email@gmail.com
# MAIL_PASSWORD=your-google-app-password
# MAIL_SMTP_AUTH=true
# MAIL_SMTP_STARTTLS_ENABLE=true
# MAIL_SMTP_STARTTLS_REQUIRED=true
#
# To get a Gmail app password:
# 1. Enable 2-Step Verification in your Google account.
# 2. Go to Google Account > Security > App passwords.
# 3. Create an app password for "Mail".
# 4. Paste that generated password here, not your normal Gmail password.
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SMTP_AUTH=false
MAIL_SMTP_STARTTLS_ENABLE=false
MAIL_SMTP_STARTTLS_REQUIRED=false
MAIL_CONNECTION_TIMEOUT_MS=10000
MAIL_TIMEOUT_MS=10000
MAIL_WRITE_TIMEOUT_MS=10000
